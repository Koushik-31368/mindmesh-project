PORT=3000
NODE_ENV=development
GROQ_API_KEY=
GEMINI_API_KEY=

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=mindmesh_chunks

# Base delay (ms) for embedding retry exponential backoff (default: 5000)
EMBED_DELAY_MS=5000



# Also index chunks into ChromaDB for vector search (optional)

CHROMA_INDEXING_ENABLED=false

# Cache TTL in ms for live-page RAG index entries (default 30 min)
LIVE_RAG_TTL_MS=1800000
